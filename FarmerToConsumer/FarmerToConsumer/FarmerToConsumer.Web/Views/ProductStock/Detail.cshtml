@model ProductStock
@{
    var products = ViewBag.ProductList as List<SelectListItem> ?? new();
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AgentSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="container border bg-white mt-2 p-4">
            <div class="row">
                <div class="col-12">
                    @if (Model.ID == 0)
                    {
                        <h2>Add New Product Stock</h2>
                    }
                    else
                    {
                        <h2>Product Stock# @Model.ID</h2>
                    }
                </div>

                <hr />
            </div>

            <form method="post">
                <input type="hidden" asp-for="ID" />

                <div class="row mb-3">
                    <label asp-for="ProductID" class="form-label">Product</label>

                    <select asp-for="ProductID" class="form-select">
                        <option value="0">Select Product</option>
                        @foreach (var product in products)
                        {
                            <option value="@product.Value" selected="@(Model.ProductID.ToString() == product.Value)">@product.Text</option>
                        }
                    </select>

                    <span asp-validation-for="ProductID" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy2"></i> &nbsp;Submit
                        </button>

                        &nbsp;

                        <a asp-action="Index" asp-controller="ProductStock" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-circle-fill"></i> &nbsp;Back To List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div></div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
