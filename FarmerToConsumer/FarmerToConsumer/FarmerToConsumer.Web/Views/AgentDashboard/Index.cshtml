@model Agent

@{
    ViewData["Title"] = "Agent Dashboard";
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AgentSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="row pt-2">
            <div class="col-12">
                <h2>Agent Dashboard</h2>
            </div>

            <hr />
        </div>

        <div class="row mt-4 mb-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <p class="mb-2">Products</p>
                        <h2>@ViewBag.ProductCount</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <p class="mb-2">Order</p>
                        <h2>@ViewBag.OrderCount</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-4">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Agent Profile</h5>
                    </div>
                    <div class="card-body">
                        @if (Model == null)
                        {
                            <div class="alert alert-warning mb-0">No profile information found.</div>
                        }
                        else
                        {
                            <p class="mb-1"><strong>Name:</strong> @Model.Name</p>
                            <p class="mb-1"><strong>Assigned Village:</strong> @Model.Area</p>
                            <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</div></div>
