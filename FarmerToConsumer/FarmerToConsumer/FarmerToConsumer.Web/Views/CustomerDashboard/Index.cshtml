@model CustomerDashboardModel

@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <p class="text-secondary mb-1">Welcome @(Model?.Customer?.Name ?? "Customer")</p>
            <h1 class="h3 mb-0">Customer Dashboard</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Products</a>
            <a class="btn btn-outline-primary" asp-controller="CustomerCart" asp-action="Index">Cart</a>
            <a class="btn btn-primary" asp-controller="CustomerOrder" asp-action="Index">Orders</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card card-body">
                <span class="text-secondary">Cart Items</span>
                <strong class="fs-3">@Model?.CartItemCount</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body">
                <span class="text-secondary">Pending Orders</span>
                <strong class="fs-3">@Model?.PendingOrders</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body">
                <span class="text-secondary">Delivered Orders</span>
                <strong class="fs-3">@Model?.DeliveredOrders</strong>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Available Products</h2>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            <div class="row g-3">
                @if (Model == null || Model.FeaturedStocks.Count == 0)
                {
                    <div class="col-12"><div class="alert alert-info mb-0">No products found.</div></div>
                }
                else
                {
                    foreach (var stock in Model.FeaturedStocks)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="border rounded p-3 h-100">
                                <span class="badge text-bg-info mb-2">@stock.Product?.Category</span>
                                <h3 class="h6">@stock.Product?.Name</h3>
                                <div class="d-flex justify-content-between">
                                    <strong>@stock.Price taka</strong>
                                    <span class="text-secondary">@stock.Quantity left</span>
                                </div>
                                <div class="mt-3">
                                    <a class="btn btn-primary btn-sm" asp-controller="CustomerCart" asp-action="Add" asp-route-dataId="@stock.ID">Add To Cart</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Recent Orders</h2>
                <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <tr class="table-info">
                        <th>Order</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Delivery</th>
                    </tr>
                    @if (Model == null || Model.RecentOrders.Count == 0)
                    {
                        <tr class="table-secondary text-center"><td colspan="4">No recent orders.</td></tr>
                    }
                    else
                    {
                        foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><a asp-controller="CustomerOrder" asp-action="Detail" asp-route-dataId="@order.ID">#@order.ID</a></td>
                                <td>@order.TotalAmount taka</td>
                                <td>@(order.Payment?.Status ?? "-")</td>
                                <td>@order.DeliveryStatus</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>
    </div>
</div>
