@model Product
@{
    var farmers = ViewBag.FarmerList as List<SelectListItem> ?? new();
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AgentSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="container border bg-white mt-2 p-4">
            <div class="row">
                <div class="col-12">
                    @if (Model.ID == 0)
                    {
                        <h2>Add New Product</h2>
                    }
                    else
                    {
                        <h2>Product# @Model.ID</h2>
                    }
                </div>

                <hr />
            </div>

            <form method="post">
                <input type="hidden" asp-for="ID" />

                <div class="row mb-3">
                    <label asp-for="FarmerId" class="form-label">Farmer</label>
                    <select asp-for="FarmerId" class="form-select">
                        <option value="0">Select Farmer</option>
                        @foreach (var farmer in farmers)
                        {
                            <option value="@farmer.Value" selected="@(Model.FarmerId.ToString() == farmer.Value)">@farmer.Text</option>
                        }
                    </select>
                    <span asp-validation-for="FarmerId" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy2"></i> &nbsp;Submit
                        </button>

                        &nbsp;

                        <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-circle-fill"></i> &nbsp;Back To List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div></div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
