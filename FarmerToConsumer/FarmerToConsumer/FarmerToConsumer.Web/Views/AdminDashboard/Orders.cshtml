@model List<FarmerToConsumer.Entities.CustomerOrder>
@{
    ViewData["Title"] = "All Orders";
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AdminSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-warning text-uppercase fw-bold mb-1">Monitor</p>
                <h2>All Orders</h2>
            </div>
        </div>

        @if (Model.Any())
        {
            @foreach (var order in Model)
            {
                <div class="card card-body bg-white text-dark shadow-sm border-0 mb-3">
                    <div>
                        <span>#@order.ID - Customer #@order.CustomerId</span>
                        <strong>@order.Status / @(order.Payment?.Status ?? "Unpaid")</strong>
                    </div>
                    <small>Total: @order.TotalAmount.ToString("0") BDT</small>
                </div>
            }
        }
        else
        {
            <div class="card card-body bg-white text-dark shadow-sm border-0 text-center text-secondary py-4">No orders have been placed yet.</div>
        }
    </section>
    </div>
</div>
