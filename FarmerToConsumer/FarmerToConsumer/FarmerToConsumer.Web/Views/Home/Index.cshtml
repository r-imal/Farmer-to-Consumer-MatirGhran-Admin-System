@model CustomerProductListModel

@{
    ViewData["Title"] = "Home";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <p class="text-secondary mb-1">Fresh from registered farmers</p>
            <h1 class="h3 mb-0">MatirGhran Products</h1>
        </div>
        <a class="btn btn-outline-primary" asp-controller="CustomerCart" asp-action="Index">
            <i class="bi bi-cart3"></i> Cart
        </a>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                @foreach (var category in Model?.Categories ?? new List<string>())
                {
                    <option value="@category" selected="@(Model?.Category == category)">@category</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <input name="search" value="@Model?.Search" class="form-control" placeholder="Search by product, category, or farmer" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>

    @if (Model == null || Model.Stocks.Count == 0)
    {
        <div class="alert alert-info">No products found.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var stock in Model.Stocks)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <span class="badge text-bg-info">@stock.Product?.Category</span>
                                <span class="badge text-bg-success">@stock.Quantity in stock</span>
                            </div>
                            <h2 class="h5">@stock.Product?.Name</h2>
                            <p class="text-secondary mb-2">Farmer: @(stock.Product?.Farmer?.Name ?? "-")</p>
                            <div class="fs-5 fw-bold mb-3">@stock.Price taka</div>
                            <div class="d-flex gap-2 mt-auto">
                                <a class="btn btn-outline-primary" asp-controller="CustomerProduct" asp-action="Details" asp-route-dataId="@stock.ID">Details</a>
                                <a class="btn btn-primary" asp-controller="CustomerCart" asp-action="Add" asp-route-dataId="@stock.ID">
                                    <i class="bi bi-cart-plus"></i> Add
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
