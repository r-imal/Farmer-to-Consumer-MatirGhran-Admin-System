@{
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : Context.Session.GetString("UserName");
    var userRole = User.Claims.FirstOrDefault(e => e.Type == System.Security.Claims.ClaimTypes.Role)?.Value
        ?? Context.Session.GetString("UserRole")
        ?? "";
    var normalizedRole = userRole.Replace(" ", "").ToLower();
    var isLoggedIn = !string.IsNullOrWhiteSpace(userName);
    var dashboardController = normalizedRole is "admin" or "superadmin"
        ? "AdminDashboard"
        : normalizedRole == "agent" ? "AgentDashboard" : normalizedRole == "consumer" ? "CustomerDashboard" : "Home";
    var useCustomerDashboardShell = normalizedRole == "consumer" && isLoggedIn;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatirGhran</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-solar.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-vh-100 d-flex flex-column mb-0 @(useCustomerDashboardShell ? "customer-dashboard-body" : "")">
@if (!useCustomerDashboardShell)
{
<header class="sticky-top">
    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span>MatirGhran</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    @if (normalizedRole == "consumer")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomerOrder" asp-action="Index">Orders</a>
                        </li>
                    }
                </ul>

                @if (isLoggedIn)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="@dashboardController" asp-action="Index">Dashboard</a>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Profile">Profile</a>
                        <a class="btn btn-secondary btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="RegisterConsumer">Register as Consumer</a>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="RegisterAgent">Register as Agent</a>
                        <a class="btn btn-secondary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    </div>
                }
            </div>
        </div>
    </nav>
</header>
}
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoginPage = currentController == "Account" && currentAction == "Login";

    var hasMessage =
        (!isLoginPage && !string.IsNullOrWhiteSpace(ViewBag.Error as string)) ||
        (!isLoginPage && !string.IsNullOrWhiteSpace(ViewBag.Success as string)) ||
        !string.IsNullOrWhiteSpace(TempData.Peek("Error")?.ToString()) ||
        !string.IsNullOrWhiteSpace(TempData.Peek("Success")?.ToString());
}
@if (hasMessage)
{
    <div class="position-fixed top-0 start-50 translate-middle-x w-75 pt-5 mt-4 z-3">
        @await Html.PartialAsync("_Message")
    </div>
}
@if (useCustomerDashboardShell)
{
    <div class="customer-dashboard-shell">
        <header class="customer-dashboard-header">
            <a class="customer-dashboard-brand" asp-controller="CustomerDashboard" asp-action="Index">MatirGhran</a>
            <a class="btn btn-outline-light btn-sm customer-logout" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </header>
        <div class="customer-dashboard-layout">
            @await Html.PartialAsync("_CustomerSidebar")
            <main role="main" class="customer-dashboard-main">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
<main role="main" class="flex-grow-1">
    @RenderBody()
</main>
}
@if (!useCustomerDashboardShell)
{
<footer class="bg-primary text-white py-3">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <div>
            <strong>MatirGhran</strong>
            <span>Easy and Efficient Solution</span>
        </div>
        <small>&copy; 2026 MatirGhran</small>
    </div>
</footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
