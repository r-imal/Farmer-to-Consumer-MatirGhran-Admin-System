{
  "openapi": "3.0.1",
  "info": {
    "title": "FarmerToConsumer.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/AdminOrder": {
      "get": {
        "tags": [
          "AdminOrder"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/AdminOrder/UpdateStatus": {
      "post": {
        "tags": [
          "AdminOrder"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/CustomerProduct/GetByID/{id}": {
      "get": {
        "tags": [
          "CustomerProduct"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Farmer": {
      "get": {
        "tags": [
          "Farmer"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "Farmer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Farmer"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Farmer"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Farmer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Farmer/GetByID/{id}": {
      "get": {
        "tags": [
          "Farmer"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "required": [
          "area",
          "name",
          "phone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "userInfoID": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "name": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "phone": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "area": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "commissionRate": {
            "type": "number",
            "format": "double"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "Farmer": {
        "required": [
          "contact",
          "district",
          "name",
          "village"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "agentId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "village": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "district": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "contact": {
            "maxLength": 11,
            "minLength": 0,
            "type": "string"
          },
          "agent": {
            "$ref": "#/components/schemas/Agent"
          }
        },
        "additionalProperties": false
      },
      "UserInfo": {
        "required": [
          "email",
          "name",
          "password",
          "phone",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "role": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "phone": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "village": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "district": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "address": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}