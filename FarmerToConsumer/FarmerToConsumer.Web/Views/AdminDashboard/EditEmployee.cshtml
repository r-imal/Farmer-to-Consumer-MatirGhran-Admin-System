@model FarmerToConsumer.Entities.UserInfo
@{
    ViewData["Title"] = "Edit Employee";
    var roleKey = (Model.Role ?? "").Replace(" ", "").ToLower();
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AdminSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-warning text-uppercase fw-bold mb-1">Employee</p>
                <h2>Edit Information</h2>
                <p class="text-secondary mb-0">Update employee contact, role, address and work details.</p>
            </div>
            <a class="btn btn-outline-secondary" asp-controller="AdminEmployee" asp-action="Employees">Back</a>
        </div>

        <form asp-controller="AdminEmployee" asp-action="EditEmployee" method="post" class="card card-body bg-white text-dark shadow-sm border-0">
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Full Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Village" class="form-label">Village</label>
                    <input asp-for="Village" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="District" class="form-label">District</label>
                    <input asp-for="District" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="admin">Admin</option>
                        <option value="agent">Agent</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label">Full Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">New Password</label>
                    <input asp-for="Password" class="form-control" value="" placeholder="Keep blank to keep current password" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" asp-controller="AdminEmployee" asp-action="Employees">Cancel</a>
                <button class="btn btn-primary" type="submit">Save Employee</button>
            </div>
        </form>
    </section>
    </div>
</div>
