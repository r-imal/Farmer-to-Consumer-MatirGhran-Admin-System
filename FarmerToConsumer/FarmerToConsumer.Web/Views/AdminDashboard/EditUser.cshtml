@model FarmerToConsumer.Entities.UserInfo
@{
    ViewData["Title"] = "Edit User";
    var roleKey = (Model.Role ?? "").Replace(" ", "").ToLower();
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AdminSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-warning text-uppercase fw-bold mb-1">Manage</p>
                <h2>Edit User</h2>
            </div>
            <a class="btn btn-outline-secondary" asp-controller="AdminEmployee" asp-action="Users">Back</a>
        </div>

        <form asp-controller="AdminEmployee" asp-action="EditUser" method="post" class="card card-body bg-white text-dark shadow-sm border-0">
            <input type="hidden" asp-for="ID" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Village" class="form-label">Village</label>
                    <input asp-for="Village" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="District" class="form-label">District</label>
                    <input asp-for="District" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    @if (roleKey == "superadmin")
                    {
                        <input type="hidden" asp-for="Role" />
                        <input class="form-control" value="superadmin" readonly />
                    }
                    else
                    {
                        <select asp-for="Role" class="form-select">
                            <option value="consumer">consumer</option>
                            <option value="agent">agent</option>
                            <option value="admin">admin</option>
                        </select>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">New Password</label>
                    <input asp-for="Password" class="form-control" value="" placeholder="Keep blank to keep current password" />
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" asp-controller="AdminEmployee" asp-action="Users">Cancel</a>
                <button class="btn btn-primary" type="submit">Save User</button>
            </div>
        </form>
    </section>
    </div>
</div>
