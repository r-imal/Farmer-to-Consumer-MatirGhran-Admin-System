@model List<FarmerToConsumer.Entities.UserInfo>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid px-0"><div class="row g-0 min-vh-100">
    <partial name="_AdminSidebar" />
    <section class="col bg-light text-dark p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-warning text-uppercase fw-bold mb-1">Manage</p>
                <h2>Users</h2>
            </div>
        </div>
        <div class="card card-body bg-white text-dark shadow-sm border-0 table-responsive">
            <table class="table table-light table-striped table-hover align-middle mb-0">
                <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Area</th><th></th></tr></thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>@user.Role</td>
                        <td>@user.Village, @user.District</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="AdminEmployee" asp-action="EditUser" asp-route-id="@user.ID">Edit</a>
                            <form asp-controller="AdminEmployee" asp-action="DeleteUser" method="post" class="m-0">
                                <input type="hidden" name="id" value="@user.ID" />
                                <button class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    </div>
</div>
